<Window x:Class="PjSip.Net.Sample.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PjSip.Net WPF Sample" Height="350" Width="500">
    <StackPanel Margin="20">
        <TextBlock x:Name="StatusText" Text="Status: Idle" FontSize="16" Margin="0,0,0,10"/>
        <Button x:Name="BtnStart" Content="Start Phone" Click="BtnStart_Click" Margin="0,5" Padding="10,5"/>
        <TextBox x:Name="TxtDestination" Text="sip:bob@example.com" Margin="0,5" Padding="5"/>
        <Button x:Name="BtnCall" Content="Make Call" Click="BtnCall_Click" Margin="0,5" Padding="10,5"/>
        <Button x:Name="BtnHangup" Content="Hang Up" Click="BtnHangup_Click" Margin="0,5" Padding="10,5"/>
        <Button x:Name="BtnStop" Content="Stop Phone" Click="BtnStop_Click" Margin="0,5" Padding="10,5"/>
        <ListBox x:Name="LogList" Height="120" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
