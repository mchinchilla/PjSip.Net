<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    PjSip.Net.Native.iOS — includes the native libpjsua2.dylib for
    ios-arm64 so that it is bundled into the iOS application.
    Excluded for simulator builds (device-only binary).
  -->
  <!-- Only real iOS device, not Mac Catalyst (which uses the macOS dylib) and not simulator -->
  <ItemGroup Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-ios')) And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst' And '$(RuntimeIdentifier)' != 'iossimulator-arm64' And '$(RuntimeIdentifier)' != 'iossimulator-x64'">
    <NativeReference Include="$(MSBuildThisFileDirectory)..\..\runtimes\ios-arm64\native\libpjsua2.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\runtimes\ios-arm64\native\libpjsua2.dylib')">
      <Kind>Dynamic</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

</Project>
