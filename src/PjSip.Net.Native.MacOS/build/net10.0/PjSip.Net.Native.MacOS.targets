<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    PjSip.Net.Native.MacOS — copies the native libpjsua2.dylib for both
    osx-x64 and osx-arm64 to the output directory so that the runtime can
    locate the correct binary via the default probing paths.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\osx-x64\native\libpjsua2.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\runtimes\osx-x64\native\libpjsua2.dylib')"
          Link="runtimes\osx-x64\native\libpjsua2.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />

    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\osx-arm64\native\libpjsua2.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\runtimes\osx-arm64\native\libpjsua2.dylib')"
          Link="runtimes\osx-arm64\native\libpjsua2.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
