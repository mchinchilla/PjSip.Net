<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    PjSip.Net.Native.Win64 — copies the native pjsua2.dll to the output directory
    so that the runtime can locate it via the default probing paths.
    (Transitive — applies to projects that indirectly reference this package.)
  -->
  <ItemGroup Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-x64\native\pjsua2.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\runtimes\win-x64\native\pjsua2.dll')"
          Link="runtimes\win-x64\native\pjsua2.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
